          }],Label:"button_194",Name:"The Overworld"
        }],Label:"question_two",Name:"Second Question",Texts:[{
          Text:"Which dimension in Minecraft is home to the Ender Dragon?"
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"end_quiz",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_33",Name:"No, sorry. No time."
        },{
          Actions:[{
            Cmd:"start_quiz",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_11",Name:"Yes, of course!"
        }],Label:"default",Name:"Welcome",Texts:[{
          Text:"Curious to see how much you know, @initiator?"
        },{
          Text:"Interested in testing your knowledge, @initiator?"
        },{
          Text:"Want to see how well you know your stuff, @initiator?"
        },{
          Text:"Up for a knowledge test, @initiator?"
        },{
          Text:"Hey @initiator, want to test your knowledge?"
        },{
          Text:"Hey there, @initiator! Ready to put your knowledge to the test?"
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"question_two",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_70",Name:"Next One ..."
        }],Label:"question_one_correct",Name:"First question: Correct",Texts:[{
          Text:"That's correct.\\nIn Minecraft, a crafting table is an essential crafting station that allows players to create more advanced items and tools.\\nTo craft a crafting table, you need four wooden planks.\\nFill the 2x2 crafting grid in your inventory with them and your crafting table is ready."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"question_one",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_564",Name:"Try again ..."
        }],Label:"question_one_wrong",Name:"First Question: Wrong",Texts:[{
          Text:"Not quite. Far too precious for a humble crafting table. Try again."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"question_one",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_2",Name:"Start quiz"
        }],Name:"Start Quiz",Texts:[{
          Text:"Splendid. Two questions, no time limit. Start whenever you are ready."
        }]
      },{
        Label:"question_two_correct",Name:"Second Question: Correct",Texts:[{
          Text:"Nice one. The End is a mysterious and otherworldly dimension in Minecraft, reached through the End portal hidden deep inside a stronghold.\\nIt is a desolate land with floating islands and obsidian pillars.\\nDefeat the Ender Dragon there and the exit portal opens to take you home."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"question_one_correct",Type:"OPEN_NAMED_DIALOG"
          },{
            Cmd:"/summon firework_rocket ~ ~1 ~ {LifeTime:30,FireworksItem:{id:firework_rocket,Count:1,tag:{Fireworks:{Flight:2,Explosions:[{Type:1,Flicker:0,Trail:1,Colors:[I;8073150,14188952],FadeColors:[I;12801229]}]}}}}",Type:"COMMAND"
          }],Label:"button_46",Name:"Wooden Planks"
        },{
          Actions:[{
