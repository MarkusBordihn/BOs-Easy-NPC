    DialogData:{
      DialogDataSet:[{
        Label:"wish_granted",Name:"Wish Granted",Priority:-1,Texts:[{
          Text:"A shimmer of starlight gathers at your feet, @initiator. Your companion has found you. Treat them kindly; some wishes have paws."
        }]
      },{
        Label:"farewell",Name:"Farewell",Priority:-1,Texts:[{
          Text:"May your path stay bright, @initiator."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"/execute as @initiator at @s run summon minecraft:wolf ~ ~ ~ {Tags:[\"easy_npc_wish_wolf\"],CollarColor:10,Sitting:0b,PersistenceRequired:1b}",
            Type:"COMMAND"
          },{
            Cmd:"/execute as @initiator at @s run data modify entity @e[type=minecraft:wolf,tag=easy_npc_wish_wolf,sort=nearest,limit=1,distance=..2] Owner set from entity @s UUID",
            Type:"COMMAND"
          },{
            Cmd:"/execute at @initiator run tag @e[type=minecraft:wolf,tag=easy_npc_wish_wolf,sort=nearest,limit=1,distance=..2] remove easy_npc_wish_wolf",
            Type:"COMMAND"
          },{
            Cmd:"/playsound minecraft:block.amethyst_block.chime master @initiator ~ ~ ~ 1 1.4",
            Type:"COMMAND"
