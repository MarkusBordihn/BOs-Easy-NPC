{
  PresetMetadata:{
    author:"Kaworru",
    category:"Quest",
    created:1784073600000L,
    description:"A smith that remembers what happens at his forge through NPC states: a lit or banked fire, how many orders he already took and which blade he is working on. Every dialog reacts to those states, so the NPC changes for everyone who visits it.",
    entityTypeId:"easy_npc:humanoid",
    modified:1784073600000L,
    name:"Forge Keeper",
    variantType:"KNIGHT_02",
    version:"1.0.0"
  },
  data:{
    ActionData:{
      ActionEventSet:{
        ON_DISTANCE_FAR:[{
          Cmd:"/playsound minecraft:block.fire.ambient master @initiator ~ ~ ~ 0.3 0.8",Type:"COMMAND"
        }],
        ON_INTERACTION:[{
          Type:"OPEN_DEFAULT_DIALOG"
        }]
      }
    },
    ArmorItems:[{},{},{},{
      Count:1b,id:"minecraft:leather_boots",tag:{
        Damage:0
      }
    }],
    Attributes:[{
      Base:1.0d,Name:"minecraft:generic.attack_damage"
    },{
      Base:16.0d,Name:"minecraft:generic.follow_range"
    },{
      Base:0.5d,Name:"minecraft:generic.movement_speed"
    }],
    CustomName:'{"color":"#D97A3C","text":"Forge Keeper"}',
    DialogData:{
      DialogDataSet:[{
        Name:"Fire Banked",Priority:-1,Texts:[{
          Text:"Ash over the coals, the fire keeps until morning. No orders until it burns again."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"toggle forge_lit",Type:"NPC_STATE"
          },{
            Cmd:"/playsound minecraft:item.flintandsteel.use master @a ~ ~ ~ 1 1",Type:"COMMAND"
          },{
            Cmd:"fire_lit",Type:"OPEN_NAMED_DIALOG"
          }],Conditions:[{
            Name:"forge_lit",Operation:"EQUALS",SubType:"FLAG",Type:"NPC_STATE"
          }],Label:"button_light",Name:"Light the forge"
        },{
          Actions:[{
            Cmd:"toggle forge_lit",Type:"NPC_STATE"
          },{
            Cmd:"/playsound minecraft:block.fire.extinguish master @a ~ ~ ~ 1 1",Type:"COMMAND"
          },{
            Cmd:"fire_banked",Type:"OPEN_NAMED_DIALOG"
          }],Conditions:[{
            Name:"forge_lit",Operation:"EQUALS",SubType:"FLAG",Type:"NPC_STATE",Value:1
          }],Label:"button_bank",Name:"Bank the fire"
        },{
          Actions:[{
            Cmd:"increase orders_taken 1",Type:"NPC_STATE"
          },{
            Cmd:"set current_order longsword",Type:"NPC_STATE"
          },{
            Cmd:"/playsound minecraft:block.anvil.use master @a ~ ~ ~ 1 1",Type:"COMMAND"
          },{
            Cmd:"order_taken",Type:"OPEN_NAMED_DIALOG"
          }],Conditions:[{
            Name:"forge_lit",Operation:"EQUALS",SubType:"FLAG",Type:"NPC_STATE",Value:1
          },{
            Name:"orders_taken",Operation:"LESS_THAN",Type:"NPC_STATE",Value:3
          }],Label:"button_order",Name:"Order a longsword"
        },{
          Actions:[{
            Cmd:"current_work",Type:"OPEN_NAMED_DIALOG"
          }],Conditions:[{
            CustomData:"longsword",Name:"current_order",Operation:"EQUALS",Type:"NPC_STATE"
          }],Label:"button_progress",Name:"What are you working on?"
        },{
          Actions:[{
            Cmd:"remove current_order",Type:"NPC_STATE"
          },{
            Cmd:"decrease orders_taken 1",Type:"NPC_STATE"
          },{
            Cmd:"order_cleared",Type:"OPEN_NAMED_DIALOG"
          }],Conditions:[{
            Name:"orders_taken",Operation:"GREATER_THAN_OR_EQUALS",Type:"NPC_STATE",Value:1
          }],Label:"button_clear",Name:"Take a blade off the bench"
        },{
          Actions:[{
            Cmd:"farewell",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_leave",Name:"I'll leave you to it"
        }],Label:"default",Name:"At the Forge",Priority:5,Texts:[{
          Text:"Welcome to my forge, @initiator.\\n\\nThe fire has to burn before I take an order, and I never keep more than three blades on the bench.\\n\\nWhatever you change here stays with me, not with you."
        }]
      },{
        Name:"Fire Lit",Priority:-1,Texts:[{
          Text:"The coals catch and the bellows breathe. Now we can work, @initiator."
        }]
      },{
        Name:"Order Taken",Priority:-1,Texts:[{
          Text:"A longsword it is. Onto the bench with it, next to the others."
        }]
      },{
        Name:"Current Work",Priority:-1,Texts:[{
          Text:"A longsword, @initiator. Folded twice, edge not set yet. Ask again after the next heat."
        }]
      },{
        Conditions:[{
          Name:"orders_taken",Operation:"GREATER_THAN_OR_EQUALS",Type:"NPC_STATE",Value:3
        }],Name:"Booked Out",Priority:10,Texts:[{
          Text:"Three blades on the bench already, @initiator. Come back when I cleared one of them.\\n\\nThe forge remembers every order, even after I close for the night."
        }]
      },{
        Name:"Order Cleared",Priority:-1,Texts:[{
          Text:"Off the bench it goes. That frees a place for the next blade."
        }]
      },{
        Name:"Farewell",Priority:-1,Texts:[{
          Text:"Mind the sparks on your way out, @initiator."
        }]
      }],
      Type:"STANDARD"
    },
    EasyNPCVersion:3,
    EntityAttribute:{
      CanBreatheUnderwater:1b
    },
    HandItems:[{
      Count:1b,id:"minecraft:iron_ingot"
    },{
