{
  PresetMetadata:{
    author:"Kaworru",
    category:"Quest",
    created:1782518400000L,
    description:"A simple skywatcher preset that uses time-of-day and weather conditions to offer different dialogs, route hints and small command effects.",
    entityTypeId:"easy_npc:humanoid",
    modified:1782518400000L,
    name:"Skywatch Scout",
    variantType:"NOOR",
    version:"1.0.0"
  },
  data:{
    ActionData:{
      ActionEventSet:{
        ON_DISTANCE_CLOSE:[{
          Cmd:"/playsound minecraft:block.note_block.chime master @initiator ~ ~ ~ 0.6 1.2",Type:"COMMAND"
        }],
        ON_INTERACTION:[{
          Type:"OPEN_DEFAULT_DIALOG"
        }]
      }
    },
    ArmorItems:[{
      Count:1b,id:"minecraft:leather_boots",tag:{
        Damage:0
      }
    },{},{},{}],
    Attributes:[{
      Base:1.0d,Name:"minecraft:generic.attack_damage"
    },{
      Base:16.0d,Name:"minecraft:generic.follow_range"
    },{
      Base:0.5d,Name:"minecraft:generic.movement_speed"
    }],
    CustomName:'{"color":"#78C7FF","text":"Mira, Skywatch Scout"}',
    DialogData:{
      DialogDataSet:[{
        Label:"storm_route",Name:"Stone Lantern Path",Priority:-1,Texts:[{
          Text:"Follow the low road to the first cracked lantern, then take the uphill path. Avoid the second bridge during storms."
        }]
      },{
        Label:"day_route",Name:"Ridge Route",Priority:-1,Texts:[{
          Text:"Use the ridge during daylight. Turn toward the birch grove when you reach the river."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"rain_route",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_rain_route",Name:"Read the muddy trail"
        }],Conditions:[{
          SubType:"RAIN",Type:"WEATHER"
        }],Label:"rain",Name:"Rain Watch",Priority:30,Texts:[{
          Text:"The rain is showing fresh tracks, @initiator. Take the road with fewer puddles."
        }]
      },{
        Label:"storm_flare",Name:"Storm Flare Sent",Priority:-1,Texts:[{
          Text:"The storm flare has been sent. Wait for clear weather before taking the road."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"/summon firework_rocket ~ ~1 ~ {LifeTime:25,FireworksItem:{id:firework_rocket,Count:1,tag:{Fireworks:{Flight:1,Explosions:[{Type:1,Flicker:1,Trail:1,Colors:[I;2437522,11743532],FadeColors:[I;15790320]}]}}}}",Type:"COMMAND"
          },{
            Cmd:"storm_flare",Type:"OPEN_NAMED_DIALOG"
          }],Conditions:[{
            SubType:"PER_DAY",Type:"EXECUTION_LIMIT",Value:1
          }],Label:"button_storm_flare",Name:"Send one storm flare"
        },{
          Actions:[{
            Cmd:"storm_route",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_storm_route",Name:"Which path is safe?"
        }],Conditions:[{
          SubType:"THUNDER",Type:"WEATHER"
        }],Label:"storm",Name:"Storm Watch",Priority:40,Texts:[{
          Text:"The storm is over the high ridge, @initiator. Avoid tall trees and follow the stone lanterns."
        }]
      },{
        Label:"night_route",Name:"Star Route",Priority:-1,Texts:[{
          Text:"Turn right at the tallest pine. If you reach the stream first, you missed the turn."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"night_route",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_night_route",Name:"Follow the star route"
        },{
          Actions:[{
            Cmd:"/particle minecraft:end_rod ~ ~2 ~ 0.35 0.2 0.35 0.02 18",Type:"COMMAND"
          },{
            Cmd:"star_signal",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_star_signal",Name:"Raise a quiet signal"
        }],Conditions:[{
          Operation:"GREATER_THAN_OR_EQUALS",Type:"TIME_OF_DAY",Value:13000
        }],Label:"night",Name:"Night Watch",Priority:20,Texts:[{
          Text:"Keep the three bright stars above the spruce line on your left to avoid the ravine, @initiator."
        }]
      },{
        Label:"star_signal",Name:"Quiet Signal",Priority:-1,Texts:[{
          Text:"The signal is up. Anyone watching the road should see it."
        }]
      },{
        Label:"rain_route",Name:"Muddy Trail",Priority:-1,Texts:[{
          Text:"Follow the cart tracks uphill to reach the sheltered pass."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"day_route",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_day_route",Name:"Ask for the daylight route"
        }],Conditions:[{
          Operation:"LESS_THAN",Type:"TIME_OF_DAY",Value:12000
        }],Label:"day",Name:"Day Watch",Priority:10,Texts:[{
          Text:"The weather is clear, @initiator. Follow the ridge to the river, then descend through the birch grove."
        }]
      },{
        Conditions:[{
          Type:"FALLBACK"
        }],Label:"fallback",Name:"Changing Light",Texts:[{
          Text:"The route changes at dawn and dusk, @initiator. Ask again shortly."
        }]
      }],
      Type:"CUSTOM"
    },
