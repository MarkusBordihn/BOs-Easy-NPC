  data:{
    ActionData:{
      ActionEventSet:{
        ON_DISTANCE_CLOSE:[{
          Cmd:"/say Oi, @initiator! Quit lurking and come trade blows. Or are your boots too heavy to step closer?",Type:"COMMAND"
        },{
          Cmd:"/playsound minecraft:entity.zoglin.ambient master @a ~ ~ ~ 1 0.8",Type:"COMMAND"
        }],
        ON_DISTANCE_VERY_CLOSE:[{
          Cmd:"/say Ha! Look at you, @initiator, struttin' right up to a war-orc. Mighty brave... or mighty foolish. Let's find out which.",Type:"COMMAND"
