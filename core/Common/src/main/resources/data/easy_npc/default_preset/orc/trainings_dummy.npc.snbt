    CustomName:'{"color":"#FF0000","text":"Grukk, the Sparring Post"}',
    DialogData:{
      DialogDataSet:[{
        Label:"strong_player",Name:"Worthy Hit",Priority:-1,Texts:[{
          Text:"Hrmph... @initiator. You strike harder than most soft-skins who wander past my post.\\n\\nThat one actually stung. Keep that fire in your arms and come back when you can make a war-chief flinch."
        }]
      },{
        Buttons:[{
          Actions:[{
            Cmd:"strong_player",Id:[I;1286773866,1885359940,-1789552604,-2147187668],Type:"OPEN_NAMED_DIALOG"
          }],Conditions:[{
            Operation:"LESS_THAN_OR_EQUALS",Type:"NPC_HEALTH",Value:90
          }],Name:"Show Grukk I've drawn blood"
        }],Label:"default",Name:"At the Post",Priority:0,Texts:[{
          Text:"Hah! Another soft-handed trainee, @initiator. I am Grukk, and I have shrugged off beatings tougher than you.\\n\\nStop staring. Draw your steel and hit me, hit me until your arms scream. Only when you've carved 100 damage from my hide will I bother to remember your name."
        }]
      }],
