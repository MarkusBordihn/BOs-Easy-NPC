          }],Conditions:[{
            Operation:"GREATER_THAN_OR_EQUALS",Type:"EXPERIENCE_LEVEL",Value:20
          }],Label:"button_veteran",Name:"Speak as a veteran (Lvl 20+)"
        },{
          Actions:[{
            Cmd:"/playsound minecraft:block.wooden_door.open master @a ~ ~ ~ 0.5 1.3",Type:"COMMAND"
          },{
            Cmd:"passage",Type:"OPEN_NAMED_DIALOG"
          }],Conditions:[{
            Name:"creative",Type:"GAMEMODE"
          }],Label:"button_creative",Name:"Slip past in Creative"
        },{
          Actions:[{
            Cmd:"/playsound minecraft:block.iron_door.open master @a ~ ~ ~ 1 1",Type:"COMMAND"
          },{
            Cmd:"passage",Type:"OPEN_NAMED_DIALOG"
          }],Conditions:[{
            Name:"minecraft:ender_pearl",Type:"HAS_ITEM_IN_INVENTORY"
          }],Label:"button_token",Name:"Show the Ender Token"
        },{
          Actions:[{
            Cmd:"farewell",Type:"OPEN_NAMED_DIALOG"
          }],Label:"button_leave",Name:"I'll be on my way"
        }],Label:"default",Name:"At the Gate",Priority:5,Texts:[{
          Text:"Halt, @initiator. None cross my threshold without proof.\\n\\nBear a Golden Seal, a gold ingot held in your hand and the gate swings wide.\\nOr show an Ender Token, a single ender pearl in your pack, and you are known to me.\\n\\nVeterans of the 20th level pass on reputation alone, and the Order walks freely in Creative.\\n\\nSo... what proof do you carry?"
        }]
      },{
        Label:"passage",Name:"Passage Granted",Priority:-1,Texts:[{
          Text:"With a heavy groan of iron, the gate yields. Pass, @initiator and may the keep keep you."
        }]
      },{
        Label:"veteran",Name:"Veteran's Path",Priority:-1,Texts:[{
          Text:"Ah, a proven veteran. No seal needed for one of your standing the armory is yours to browse."
        }]
      },{
        Conditions:[{
          Name:"warden",Type:"TEAM"
        }],Label:"order",Name:"Order Welcome",Priority:10,Texts:[{
          Text:"The Order welcomes you home, @initiator. The inner keep stands open to you."
        }]
      },{
        Name:"Farewell",Priority:-1,Texts:[{
          Text:"Safe travels, @initiator. The gate remains, should you return prepared."
        }]
      }],
      Type:"STANDARD"
    },
