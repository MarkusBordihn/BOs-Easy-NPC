    DialogData:{
      DialogDataSet:[{
        Buttons:[{
          Name:"Close"
        }],Name:"Default",Texts:[{
          Text:"Breathe in through the nose, @initiator. Breathe out through the worries."
        },{
          Text:"Stand on one leg long enough, and the world starts to balance with you."
        },{
          Text:"The mountain does not rush. Neither should you."
        },{
          Text:"A stiff back holds a stiff mind. Stretch, and both will loosen."
        },{
          Text:"Even a creeper finds peace, just once, at the very end."
        }]
