  @Override
  public void handleSkinVariantTypeChange(Enum<?> variant) {
    VillagerData villagerData = this.getVillagerData();

    Holder<VillagerProfession> profession = this.getVillagerProfession(variant);
    if (profession != null) {
      villagerData = villagerData.withProfession(profession);
    }

    Holder<VillagerType> type = this.getVillagerType(variant);
    if (type != null) {
      villagerData = villagerData.withType(type);
    }

    this.setVillagerData(villagerData);

    if (this.level() instanceof ServerLevel serverLevel) {
      this.refreshBrain(serverLevel);
    }
  }

  @Override
  public MerchantOffers getOffers() {
    if (this.getMerchantTradingOffers() == null) {
      this.updateMerchantTradingOffers(null);
    }

    return this.getMerchantTradingOffers();
  }

  @Override
  protected void updateTrades(ServerLevel serverLevel) {
    // Use TradingDataCapable functionality instead of vanilla villager trading
    this.updateMerchantTradingOffers(serverLevel);
  }

  @Override
  public void notifyTrade(MerchantOffer merchantOffer) {
    this.handleTradeNotification(merchantOffer);
  }

  @Override
  public void notifyTradeUpdated(ItemStack itemStack) {
    this.handleTradeUpdatedNotification(itemStack);
  }
