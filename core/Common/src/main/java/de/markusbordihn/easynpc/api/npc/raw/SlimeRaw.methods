  public static net.minecraft.world.entity.ai.attributes.AttributeSupplier.Builder createAttributes() {
    return net.minecraft.world.entity.Mob.createMobAttributes()
        .add(net.minecraft.world.entity.ai.attributes.Attributes.ARMOR_TOUGHNESS, 0.0D)
        .add(net.minecraft.world.entity.ai.attributes.Attributes.ARMOR, 0.0D)
        .add(net.minecraft.world.entity.ai.attributes.Attributes.ATTACK_DAMAGE, 0.0D)
        .add(net.minecraft.world.entity.ai.attributes.Attributes.ATTACK_KNOCKBACK, 0.0D)
        .add(net.minecraft.world.entity.ai.attributes.Attributes.ATTACK_SPEED, 0.0D)
        .add(net.minecraft.world.entity.ai.attributes.Attributes.FOLLOW_RANGE, 32.0D)
        .add(net.minecraft.world.entity.ai.attributes.Attributes.KNOCKBACK_RESISTANCE, 0.0D)
        .add(net.minecraft.world.entity.ai.attributes.Attributes.MAX_HEALTH, 16.0D)
        .add(net.minecraft.world.entity.ai.attributes.Attributes.MOVEMENT_SPEED, 0.5F)
        .add(net.minecraft.world.entity.ai.attributes.Attributes.SPAWN_REINFORCEMENTS_CHANCE, 0.0D);
  }
