  @Override
  public UUID getOwnerUUID() {
    Optional<UUID> ownerUUID = getSynchedEntityData(SynchedDataIndex.OWNER_UUID);
    return ownerUUID.orElse(null);
  }

  @Override
  public void handleSkinVariantTypeChange(Enum<?> variant) {
    if (!(variant instanceof CatSkinVariant catSkinVariant)) {
      return;
    }

    ResourceKey<CatVariant> catVariantKey = catSkinVariant.getVanillaVariant();
    CatVariant catVariantHolder = BuiltInRegistries.CAT_VARIANT.get(catVariantKey);
    if (catVariantHolder != null) {
      this.setVariant(catVariantHolder);
    }
  }
