  @Override
  public UUID getOwnerUUID() {
    EntityReference<LivingEntity> ownerReference = getOwnerReference();
    return ownerReference == null ? null : ownerReference.getUUID();
  }

  @Override
  public EntityReference<LivingEntity> getOwnerReference() {
    Optional<EntityReference<LivingEntity>> ownerReference =
        getSynchedEntityData(SynchedDataIndex.OWNER_REFERENCE);
    return ownerReference.orElse(null);
  }

  @Override
  public void handleSkinVariantTypeChange(Enum<?> variant) {
    if (!(variant instanceof CatSkinVariant catSkinVariant)) {
      return;
    }

    ResourceKey<CatVariant> catVariantKey = catSkinVariant.getVanillaVariant();
    if (this.level() != null) {
      Holder<CatVariant> catVariantHolder =
          this.level()
              .registryAccess()
              .lookupOrThrow(Registries.CAT_VARIANT)
              .getOrThrow(catVariantKey);
      ReflectionUtils.invokeMethod(
          this,
          new String[]{"setVariant", "m_328033_", "method_6882"},
          new Class<?>[]{Holder.class},
          catVariantHolder);
    }
  }
