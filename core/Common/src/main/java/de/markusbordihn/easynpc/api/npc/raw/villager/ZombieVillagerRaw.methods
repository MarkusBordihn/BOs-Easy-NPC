  @Override
  public void handleSkinVariantTypeChange(Enum<?> variant) {
    VillagerData villagerData = this.getVillagerData();

    VillagerProfession profession = this.getVillagerProfession(variant);
    if (profession != null) {
      villagerData = villagerData.setProfession(profession);
    }

    VillagerType type = this.getVillagerType(variant);
    if (type != null) {
      villagerData = villagerData.setType(type);
    }

    this.setVillagerData(villagerData);
  }

  @Override
  public SpawnGroupData getVanillaSpawnGroupData(SpawnGroupData spawnGroupData) {
    return spawnGroupData == null ? new Zombie.ZombieGroupData(false, false) : spawnGroupData;
  }

  @Override
  public void setCanBreakDoors(boolean canBreakDoors) {}

  @Override
  protected void handleAttributes(float difficultyModifier) {}

  @Override
  protected void populateDefaultEquipmentSlots(
      RandomSource randomSource, DifficultyInstance difficulty) {}

  @Override
  public boolean isConverting() {
    return false;
  }
